APP_ENV=development
DATABASE_URL=sqlite:///./job_search.db
# PostgreSQL example (requires: pip install -e ".[postgres]"):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/job_search
# Opt-in only, dev/test convenience: run `alembic upgrade head` automatically
# on app startup. Leave unset/false in production — run migrations
# explicitly (manually or in CI/CD) before starting the app there.
ALEMBIC_AUTO_UPGRADE=false
API_KEY=replace-with-a-long-random-secret
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=5
TELEGRAM_MAX_RETRIES=3
MIN_JOB_SCORE_TO_NOTIFY=80

# Bundesagentur fuer Arbeit "Jobsuche" collector (POST /api/v1/collectors/bundesagentur/run).
# There is no official self-service developer portal for a personal key;
# the community-reverse-engineered API (see README "Collectors" section)
# uses the shared client id "jobboerse-jobsuche" as X-API-Key. Unofficial and
# undocumented by Bundesagentur itself — may change or stop working without notice.
BUNDESAGENTUR_API_KEY=
BUNDESAGENTUR_SEARCH_KEYWORDS=
BUNDESAGENTUR_SEARCH_LOCATION=
BUNDESAGENTUR_SEARCH_RADIUS_KM=25

# XING job-digest email collector (POST /api/v1/collectors/xing/run).
# IMAP App Password, not your main account password — see README "Collectors"
# -> "XING (email digest)" for how to generate one.
# HARD CONSTRAINT: this collector never opens the per-recipient tracking
# links inside these emails — see app/collectors/xing_email.py.
XING_MAILBOX_IMAP_HOST=imap.gmail.com
XING_MAILBOX_IMAP_PORT=993
XING_MAILBOX_USERNAME=
XING_MAILBOX_APP_PASSWORD=
XING_LOOKBACK_DAYS=7

# Company Research Agent (POST/GET /api/v1/jobs/{id}/research, Telegram
# /research <id>). v1 makes ZERO outbound network requests — its only
# provider builds research purely from a job's own already-persisted data
# (see README "Company Research Agent" for why a website-fetch sub-feature
# was removed rather than hardened). No API key/config is needed for it to
# run.
# How long a cached research result is reused before a refresh is attempted.
COMPANY_RESEARCH_TTL_HOURS=720
# Off by default: automatically research the company behind a high-scoring
# (APPLY) job right after a collector run persists it.
COMPANY_RESEARCH_AUTO_ENABLED=false
# Caps how many automatic research runs a single collector run can trigger,
# regardless of how many APPLY jobs it produces. Does not limit manual
# triggers (POST /jobs/{id}/research, Telegram /research).
COMPANY_RESEARCH_AUTO_MAX_PER_RUN=20

# Gmail Inbox Foundation (Stage 7A — POST /api/v1/gmail/sync). Read-only IMAP
# App Password against the mailbox that actually receives recruiter replies —
# deliberately separate from XING_MAILBOX_* above (different mailbox/purpose,
# see app/providers/email/ and app/collectors/xing_email.py). Sync only
# fetches, normalizes, and stores messages read-only: it never marks read,
# deletes, moves, sends, or creates drafts, and never changes Job/Application
# status. Generate a Gmail App Password (requires 2-Step Verification):
# https://myaccount.google.com/apppasswords
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_MAILBOX=INBOX
GMAIL_LOOKBACK_DAYS=30

# Stage 8B scheduler (standalone `python -m app.scheduler` worker). Off by
# default -- opt-in only. See README "Automation Scheduler (Stage 8B)".
AUTOMATION_SCHEDULER_ENABLED=false
AUTOMATION_SCHEDULER_ACCOUNT_KEY=
AUTOMATION_SCHEDULER_INTERVAL_SECONDS=3600
AUTOMATION_SCHEDULER_POLL_SECONDS=15

# Stage 8C automatic shortlist + CV/Bewerbung draft preparation. Off by
# default -- independent of AUTOMATION_SCHEDULER_ENABLED above (enabling
# the scheduler does not imply document drafting should also run
# automatically). See README "Automatic Shortlist + Draft Preparation
# (Stage 8C)". Never sends anything and never changes Job.status --
# generated CV/Bewerbung remain drafts requiring human approval. Candidate
# jobs are the EXACT set this automation run's own collectors persisted
# (in-memory attribution, never a last_seen_at timestamp guess) -- a job
# refreshed by a concurrent run or another account is never included.
AUTOMATION_AUTO_PREPARE_ENABLED=false
AUTOMATION_SHORTLIST_MIN_MATCH_SCORE=80
AUTOMATION_SHORTLIST_MAX_PER_RUN=10
# Bounds how many of THIS run's touched jobs ever get a (cheap, no-LLM,
# no-network) CandidateJobMatch computed at all -- a deterministic
# JobRecord.score-DESC/id-ASC preselection is applied before matching, so
# a large collector run can never trigger unbounded match computation.
# Must be >= AUTOMATION_SHORTLIST_MAX_PER_RUN (unless that is 0).
AUTOMATION_CANDIDATE_MATCH_MAX_PER_RUN=100

# Stage 8D automated Gmail response-draft cycle + follow-up proposal
# cycle. Two independent opt-in switches, off by default, unrelated to
# every other automation flag above (enabling the scheduler or Stage 8C
# drafting does not imply Gmail/follow-up automation should also run).
# See README "Automated Gmail Response-Draft + Follow-Up Cycle (Stage
# 8D)". Gmail sync stays read-only; response drafts and follow-up
# proposals are DRAFTS/PROPOSALS ONLY -- nothing is ever sent, nothing is
# ever approved, Job.status is never mutated. Progress is persisted
# (automation_mail_progress table) and crash-safe.
AUTOMATION_GMAIL_CYCLE_ENABLED=false
# Bounds how many already-persisted Gmail messages (per account, per run)
# the gmail_response_drafts step scans/analyzes/drafts for -- keyset
# pagination by GmailMessageRecord.id, never resets/wraps (new messages
# always get larger ids and are naturally reached later).
AUTOMATION_GMAIL_PROCESS_MAX_PER_RUN=100
AUTOMATION_FOLLOW_UP_CYCLE_ENABLED=false
# Bounds how many currently-APPLIED jobs (per account, per run) the
# follow_up_proposals step re-evaluates -- a bounded, WRAPPING
# round-robin scan (unlike the Gmail cursor above): once a pass reaches
# the end of currently-APPLIED jobs, the cursor resets so the next run
# starts again from the oldest one, letting jobs whose eligibility became
# due purely because time passed get periodically re-checked.
AUTOMATION_FOLLOW_UP_JOB_MAX_PER_RUN=100
