APP_ENV=development
DATABASE_URL=sqlite:///./job_search.db
# PostgreSQL example (requires: pip install -e ".[postgres]"):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/job_search
# Opt-in only, dev/test convenience: run `alembic upgrade head` automatically
# on app startup. Leave unset/false in production — run migrations
# explicitly (manually or in CI/CD) before starting the app there.
ALEMBIC_AUTO_UPGRADE=false
API_KEY=replace-with-a-long-random-secret
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=5
TELEGRAM_MAX_RETRIES=3
MIN_JOB_SCORE_TO_NOTIFY=80

# Bundesagentur fuer Arbeit "Jobsuche" collector (POST /api/v1/collectors/bundesagentur/run).
# There is no official self-service developer portal for a personal key;
# the community-reverse-engineered API (see README "Collectors" section)
# uses the shared client id "jobboerse-jobsuche" as X-API-Key. Unofficial and
# undocumented by Bundesagentur itself — may change or stop working without notice.
BUNDESAGENTUR_API_KEY=
BUNDESAGENTUR_SEARCH_KEYWORDS=
BUNDESAGENTUR_SEARCH_LOCATION=
BUNDESAGENTUR_SEARCH_RADIUS_KM=25

# XING job-digest email collector (POST /api/v1/collectors/xing/run).
# IMAP App Password, not your main account password — see README "Collectors"
# -> "XING (email digest)" for how to generate one.
# HARD CONSTRAINT: this collector never opens the per-recipient tracking
# links inside these emails — see app/collectors/xing_email.py.
XING_MAILBOX_IMAP_HOST=imap.gmail.com
XING_MAILBOX_IMAP_PORT=993
XING_MAILBOX_USERNAME=
XING_MAILBOX_APP_PASSWORD=
XING_LOOKBACK_DAYS=7
