# Stage 10 — Real-world Pilot / Shadow Mode staging config.
#
# Copy to `.env` (gitignored — never commit real values) and fill in the
# blank credential fields with real secrets before running the pilot.
# Every flag below is chosen so the system ingests, scores, matches,
# researches, and drafts against REAL external data while every path that
# could transmit a real message to a recruiter/company stays OFF.
#
# ABSOLUTE RULE FOR THIS PILOT: OUTBOUND_SENDING_ENABLED must stay false.
# Do not flip it to true for any reason during Stage 10 — see
# docs/STAGE_10_PILOT.md.

APP_ENV=staging
DATABASE_URL=sqlite:///./stage10_pilot.db
ALEMBIC_AUTO_UPGRADE=false
API_KEY=replace-with-a-long-random-secret
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Telegram notifications (Stage 8E + score-threshold notify) -----------
# Real bot token/chat id required for notifications to fire. Leave blank to
# run the pilot without Telegram output (collector/API responses still show
# results either way).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=5
TELEGRAM_MAX_RETRIES=3
MIN_JOB_SCORE_TO_NOTIFY=80

# --- Bundesagentur collector (real job ingestion) --------------------------
BUNDESAGENTUR_API_KEY=
BUNDESAGENTUR_SEARCH_KEYWORDS=
BUNDESAGENTUR_SEARCH_LOCATION=
BUNDESAGENTUR_SEARCH_RADIUS_KM=25

# --- XING email-digest collector (real job ingestion) -----------------------
# Read-only IMAP App Password against the mailbox that receives XING digest
# emails. Known accepted risk (see CLAUDE.md "Known security-relevant risk"):
# a full-access app password against a real mailbox, not one scoped to job
# alerts only. Acceptable for this pilot only because the collector itself
# is read-only (SELECT, no mutation) and never follows tracking links.
XING_MAILBOX_IMAP_HOST=imap.gmail.com
XING_MAILBOX_IMAP_PORT=993
XING_MAILBOX_USERNAME=
XING_MAILBOX_APP_PASSWORD=
XING_LOOKBACK_DAYS=7

# --- Company Research Agent -------------------------------------------------
# Auto-enabled so a high-scoring (APPLY) job gets researched immediately
# after a collector run, capped low to keep the pilot's first pass bounded
# and observable.
COMPANY_RESEARCH_TTL_HOURS=720
COMPANY_RESEARCH_AUTO_ENABLED=true
COMPANY_RESEARCH_AUTO_MAX_PER_RUN=5

# --- Gmail read/sync (Stage 7A) ---------------------------------------------
# Read-only IMAP. Never marks read, deletes, moves, or sends. Leave blank to
# skip Gmail entirely for this pilot pass (draft generation and scoring do
# not require it).
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_MAILBOX=INBOX
GMAIL_LOOKBACK_DAYS=30

# --- Stage 9 fail-closed outbound kill switch -------------------------------
# MUST stay false for the entire Stage 10 pilot. This is the ABSOLUTE RULE.
OUTBOUND_SENDING_ENABLED=false

# --- Stage 8B scheduler ------------------------------------------------------
# Enabled so collection/scoring/matching/drafting run periodically without
# manual triggering, per the pilot's "shadow mode" goal. 1800s (30 min) is
# a conservative pilot cadence — lower than the 3600s production default so
# observations accumulate within a reasonable session, but still far above
# the 60s floor to avoid hammering upstream collectors/mailboxes.
AUTOMATION_SCHEDULER_ENABLED=true
AUTOMATION_SCHEDULER_ACCOUNT_KEY=stage10-pilot
AUTOMATION_SCHEDULER_INTERVAL_SECONDS=1800
AUTOMATION_SCHEDULER_POLL_SECONDS=15

# --- Stage 8C auto shortlist + CV/Bewerbung draft preparation --------------
# Draft-only, never sends, never changes Job.status. Capped low for the
# pilot's first pass.
AUTOMATION_AUTO_PREPARE_ENABLED=true
AUTOMATION_SHORTLIST_MIN_MATCH_SCORE=80
AUTOMATION_SHORTLIST_MAX_PER_RUN=5
AUTOMATION_CANDIDATE_MATCH_MAX_PER_RUN=50

# --- Stage 8D Gmail response-draft cycle + follow-up proposal cycle --------
# Draft/proposal only — nothing is ever sent or approved automatically.
# Only takes effect if GMAIL_USERNAME/GMAIL_APP_PASSWORD above are set.
AUTOMATION_GMAIL_CYCLE_ENABLED=true
AUTOMATION_GMAIL_PROCESS_MAX_PER_RUN=50
AUTOMATION_FOLLOW_UP_CYCLE_ENABLED=true
AUTOMATION_FOLLOW_UP_JOB_MAX_PER_RUN=50

# --- Stage 8E daily Telegram digest -----------------------------------------
# Off by default for the pilot — the scheduler's own run notifications and
# manual inspection are enough for a short observation window. Flip to true
# only if a multi-day pilot is intended and TELEGRAM_* above are set.
TELEGRAM_DAILY_DIGEST_ENABLED=false
TELEGRAM_DAILY_DIGEST_HOUR=8
TELEGRAM_DAILY_DIGEST_TIMEZONE=Europe/Berlin
